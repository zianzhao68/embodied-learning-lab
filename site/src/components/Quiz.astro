---
import katex from 'katex'
import type { QuizQuestion } from '../data/quizzes'

interface Props {
  courseId: string
  questions: QuizQuestion[]
}

const { courseId, questions } = Astro.props
const math = (value: string) => value.replace(/\$([^$]+)\$/g, (_, formula) =>
  katex.renderToString(formula, { throwOnError: false, output: 'htmlAndMathml' })
)
---

<section class="quiz" id="课程测试" data-quiz data-course-id={courseId}>
  <div class="quiz-heading">
    <span>KNOWLEDGE CHECK</span>
    <h2>本课测试</h2>
    <p>不要回看正文。提交后即时给出结果与解释，成绩仅保存在当前设备。</p>
  </div>
  <form>
    {questions.map((question, index) => (
      <fieldset class="question" data-question data-answer={question.answer.join(',')}>
        <legend>
          <span>{String(index + 1).padStart(2, '0')}</span>
          <span set:html={math(question.question)} />
          {question.multiple && <small>多选</small>}
        </legend>
        <div class="options">
          {question.options.map((option, optionIndex) => (
            <label>
              <input type={question.multiple ? 'checkbox' : 'radio'} name={`q${index}`} value={optionIndex} />
              <span class="option-mark"></span>
              <span set:html={math(option)} />
            </label>
          ))}
        </div>
        <div class="feedback" aria-live="polite" data-explain={question.explain}></div>
      </fieldset>
    ))}
    <button class="button primary submit-quiz" type="submit">提交答案 <span aria-hidden="true">→</span></button>
    <div class="quiz-result" aria-live="polite"></div>
  </form>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-quiz]').forEach((quiz) => {
    const form = quiz.querySelector('form')
    if (!form) return
    form.addEventListener('submit', (event) => {
      event.preventDefault()
      const fields = [...form.querySelectorAll<HTMLElement>('[data-question]')]
      let score = 0
      fields.forEach((field) => {
        const selected = [...field.querySelectorAll<HTMLInputElement>('input:checked')]
          .map((input) => Number(input.value)).sort((a, b) => a - b)
        const answer = (field.dataset.answer ?? '').split(',').filter(Boolean)
          .map(Number).sort((a, b) => a - b)
        const correct = selected.length === answer.length && selected.every((value, i) => value === answer[i])
        if (correct) score += 1
        field.classList.toggle('correct', correct)
        field.classList.toggle('wrong', !correct)
        const feedback = field.querySelector<HTMLElement>('.feedback')
        if (feedback) feedback.innerHTML = `<strong>${correct ? '回答正确' : '需要复习'}</strong><span>${feedback.dataset.explain ?? ''}</span>`
      })
      const percent = Math.round(score / fields.length * 100)
      const passed = percent >= 80
      const courseId = quiz.dataset.courseId ?? ''
      localStorage.setItem(`course:${courseId}:score`, String(percent))
      if (passed) localStorage.setItem(`course:${courseId}:done`, '1')
      const result = quiz.querySelector<HTMLElement>('.quiz-result')
      if (result) {
        result.innerHTML = `<strong>${score} / ${fields.length}</strong><span>${passed ? '已达到本课通过标准。建议在第 1、3、7、14 天主动回忆。' : '建议重读错误对应章节，稍后再次测试。通过标准为 80%。'}</span>`
        result.scrollIntoView({ behavior: 'smooth', block: 'center' })
      }
    })
  })
</script>
